# ==============================================================================
# Institutional CMS Platform - Environment Variables Template
# 
# IMPORTANT: This is a template file. Duplicate this to create a `.env.local` 
# or `.env` file and replace the placeholder values with your actual credentials.
# NEVER commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core
# ------------------------------------------------------------------------------
# The display name of the institution/platform
NEXT_PUBLIC_APP_NAME="Institution Name CMS"

# The primary URL of your application (e.g., http://localhost:3000 for local dev, https://www.yourdomain.edu for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anon/Public key (Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# Your Supabase Service Role key (Project Settings -> API -> Project API keys -> service_role secret)
# NEVER EXPOSE THIS TO THE CLIENT-SIDE
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"


# ------------------------------------------------------------------------------
# Authentication (NextAuth / Custom Auth)
# ------------------------------------------------------------------------------
# A random string used to hash tokens, sign cookies, and generate cryptographic keys.
# Generate one using `openssl rand -base64 32` or https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-nextauth-secret-placeholder"

# The canonical URL of your site (often the same as NEXT_PUBLIC_APP_URL)
NEXTAUTH_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# Operational & Maintenance
# ------------------------------------------------------------------------------
# Toggle global maintenance mode. If 'true', public routes redirect to /maintenance
NEXT_PUBLIC_MAINTENANCE_MODE="false"


# ------------------------------------------------------------------------------
# Analytics & Tracking
# ------------------------------------------------------------------------------
# Toggle internal or external analytics loading (e.g., Google Analytics, Plausible)
NEXT_PUBLIC_ENABLE_ANALYTICS="false"


# ------------------------------------------------------------------------------
# Global SEO Defaults
# ------------------------------------------------------------------------------
# Default title template for metadata generation
NEXT_PUBLIC_SITE_DEFAULT_TITLE="Institution Name - Excellence in Education"

# Default meta description
NEXT_PUBLIC_SITE_DEFAULT_DESCRIPTION="Official institutional portal, academic resources, and campus management system."


# ------------------------------------------------------------------------------
# Storage & Media
# ------------------------------------------------------------------------------
# The name of the primary Supabase Storage bucket used for uploads (e.g., images, documents)
NEXT_PUBLIC_STORAGE_BUCKET="public-assets"


# ------------------------------------------------------------------------------
# Global Contact Information
# ------------------------------------------------------------------------------
# Default fallback email for inquiries and support
NEXT_PUBLIC_CONTACT_EMAIL="info@institution.edu"

# Default fallback phone number
NEXT_PUBLIC_CONTACT_PHONE="+18005550199"


# ------------------------------------------------------------------------------
# Social Media Integrations
# ------------------------------------------------------------------------------
# URLs for institutional social media profiles
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/institution"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/institution"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/institution"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/school/institution"
