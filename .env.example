# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Your Supabase project URL and Anon Key.
# These are safe to expose in the browser as long as Row Level Security (RLS) 
# is strictly enforced on your database tables.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"

# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
# Core application settings. 
# Update NEXT_PUBLIC_APP_URL to your actual domain in production (e.g., https://cms.institution.edu)
NEXT_PUBLIC_APP_NAME="Lumina CMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_THEME="medical_college"

# ==============================================================================
# SEO DEFAULTS
# ==============================================================================
# Fallback SEO metadata used globally when page-specific SEO is not defined.
NEXT_PUBLIC_DEFAULT_SEO_TITLE="Lumina Institute | Excellence in Education"
NEXT_PUBLIC_DEFAULT_SEO_DESCRIPTION="Official website of Lumina Institute, empowering the next generation of innovators and healthcare professionals."

# ==============================================================================
# UPLOAD SETTINGS
# ==============================================================================
# Maximum allowed file upload size in bytes.
# Default is 5MB (5 * 1024 * 1024 = 5242880 bytes)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=5242880

# ==============================================================================
# FUTURE EMAIL INTEGRATION (SERVER-SIDE ONLY)
# ==============================================================================
# SMTP credentials for sending transactional emails (e.g., admissions alerts, password resets).
# DO NOT prefix these with NEXT_PUBLIC_ to ensure they remain secure on the server.
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_USER="no-reply@yourdomain.com"
SMTP_PASSWORD="your-secure-smtp-password"

# ==============================================================================
# FUTURE ANALYTICS
# ==============================================================================
# Google Analytics Measurement ID (or alternative provider ID).
# Keep empty in development to prevent polluted metrics.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ==============================================================================
# FUTURE MULTI-TENANT SUPPORT
# ==============================================================================
# Determines the architectural mode of the CMS.
# Set to "single" for a standard deployment, or "multi" for SaaS/networked campuses.
NEXT_PUBLIC_PLATFORM_MODE="single"
